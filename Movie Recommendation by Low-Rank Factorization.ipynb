    "# 10. Calculaete the baseline averages\n",
    "\n",
    "\n",
    "# average for the entire trainging set\n",
    "global_avg = train[\"rating\"].mean()\n",
    "\n",
    "# average per each user\n",
    "user_avg = train.groupby(\"user_id\")[\"rating\"].mean()\n",
    "\n",
    "# average per each movie\n",
    "movie_avg = train.groupby(\"movie_id\")[\"rating\"].mean()\n",
    "\n",
    "\n",
    "print(\"Global mean:\", global_avg)\n",
    "print(\"\\nFirst five user means:\")\n",
    "print(user_avg.head())\n",
    "print(\"\\nFirst five movie means:\")\n",
    "print(movie_avg.head())"
   ]
