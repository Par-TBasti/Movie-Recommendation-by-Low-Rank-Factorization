   "source": [
    "# 6. Create the initial split\n",
    "\n",
    "# Shuffle the ratings\n",
    "\n",
    "# frac=1 means we want to return all rows in a random order. random_state=42 ensures that the shuffle is reproducible.\n",
    "shuffled = ratings.sample(frac=1, random_state=42)\n",
    "\n",
    "# Calculate the size of each part\n",
    "n = len(shuffled)\n",
    "n_train = int(n * 0.8)\n",
    "n_validation = int(n * 0.1)\n",
    "\n",
    "# Split the rows\n",
    "train = shuffled[:n_train].copy()\n",
    "\n",
    "validation = shuffled[n_train:n_train + n_validation].copy()\n",
    "\n",
    "test = shuffled[n_train + n_validation:].copy()\n",
    "\n",
    "print(\"Train:\", len(train))\n",
    "print(\"Validation:\", len(validation))\n",
    "print(\"Test:\", len(test))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "044fc769",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. Define a function to make a warm start by moving rows from the validation or test set to the training set if they contain new users or movies not present in the training set.\n",
    "\n",
    "def make_warm_start(train, data):\n",
    "    \n",
    "# Create lists of unique users and movies in the training set\n",
    "    train_users = train[\"user_id\"].unique().tolist()\n",
    "    train_movies = train[\"movie_id\"].unique().tolist()\n",
    "\n",
    "    rows_to_move = []\n",
    "\n",
    "\n",
    "# Check each rating in the validation or test set\n",
    "    for index, row in data.iterrows():\n",
    "        user = row[\"user_id\"]\n",
    "        movie = row[\"movie_id\"]\n",
    "# Select this row if its user or movie is missing from training\n",
    "        if user not in train_users or movie not in train_movies:\n",
    "            rows_to_move.append(index)\n",
    "\n",
    "            if user not in train_users:\n",
    "                train_users.append(user)\n",
    "\n",
    "            if movie not in train_movies:\n",
    "                train_movies.append(movie)\n",
    "\n",
    "# Move the selected rows into training\n",
    "    rows = data.loc[rows_to_move]\n",
    "    train = pd.concat([train, rows])\n",
    "    data = data.drop(index=rows_to_move)\n",
    "\n",
    "    print(\"Rows moved to training:\", len(rows_to_move))\n",
    "\n",
    "    return train, data"
   ]
  },
