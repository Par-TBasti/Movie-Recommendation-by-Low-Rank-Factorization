   "source": [
    "# 13. Build the zero-filled training matrix\n",
    "\n",
    "R = train.pivot(\n",
    "    index=\"user_id\",\n",
    "    columns=\"movie_id\",\n",
    "    values=\"rating\"\n",
    ").fillna(0)\n",
    "\n",
    "R_array = R.to_numpy(dtype=float)\n",
    "\n",
    "print(\"Matrix shape:\", R_array.shape)\n",
    "R.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "aa6cd36c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "U shape: (943, 943)\n",
      "s shape: (943,)\n",
      "Vt shape: (943, 1682)\n"
     ]
    }
   ],
   "source": [
    "# 14. Decompose the training matrix\n",
    "\n",
    "U, s, Vt = np.linalg.svd(R_array, full_matrices=False)\n",
    "\n",
    "print(\"U shape:\", U.shape)\n",
    "print(\"s shape:\", s.shape)\n",
    "print(\"Vt shape:\", Vt.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "68ed08c0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(943, 1682)\n"
     ]
    }
   ],
   "source": [
    "# 15. naive zero-filled reconstruction\n",
    "k = 10\n",
    "\n",
    "U_small = U[:, :k]\n",
    "s_small = s[:k]\n",
    "Vt_small = Vt[:k, :]\n",
    "\n",
    "\n",
    "# Put the singular values on a diagonal\n",
    "Sigma_small = np.diag(s_small)\n",
    "\n",
    "# Build the approximate rating matrix\n",
    "predicted_matrix = U_small @ Sigma_small @ Vt_small\n",
    "\n",
    "print(predicted_matrix.shape)"
   ]
  },
