    "# 12. Compare the baselines on validation data\n",
    "\n",
    "results = []\n",
    "\n",
    "for model in [\"global_avg\", \"user_avg\", \"movie_avg\"]:\n",
    "    errors = (\n",
    "        validation_predictions[model]\n",
    "        - validation_predictions[\"rating\"]\n",
    "    )\n",
    "\n",
    "    rmse = np.sqrt((errors ** 2).mean())\n",
    "    mae = errors.abs().mean()\n",
    "\n",
    "    results.append({\n",
    "        \"Model\": model,\n",
    "        \"RMSE\": rmse,\n",
    "        \"MAE\": mae\n",
    "    })\n",
    "\n",
    "baseline_results = pd.DataFrame(results)\n",
    "baseline_results.round(4)"
   ]
  },
