   "source": [
    "# 8. Check for cold-start rows in the validation and test sets\n",
    "\n",
    "train_users = train[\"user_id\"].unique().tolist()\n",
    "train_movies = train[\"movie_id\"].unique().tolist()\n",
    "\n",
    "\n",
    "validation_cold = 0\n",
    "\n",
    "for index, row in validation.iterrows():\n",
    "    if row[\"user_id\"] not in train_users or row[\"movie_id\"] not in train_movies:\n",
    "        validation_cold = validation_cold + 1\n",
    "\n",
    "\n",
    "test_cold = 0\n",
    "\n",
    "for index, row in test.iterrows():\n",
    "    if row[\"user_id\"] not in train_users or row[\"movie_id\"] not in train_movies:\n",
    "        test_cold = test_cold + 1\n",
    "\n",
    "# results must be 0, otherwise we have a cold-start problem in the validation or test set\n",
    "print(\"Cold-start rows in validation:\", validation_cold)\n",
    "print(\"Cold-start rows in test:\", test_cold)"
   ]
  },
